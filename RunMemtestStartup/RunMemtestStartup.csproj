<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ApplicationIcon>NewDang.ico</ApplicationIcon>
		<Company>DangWang</Company>
		<Authors>DangWang</Authors>
	</PropertyGroup>

	<!-- Version: passed in by the release script, e.g. -p:ReleaseVersion=6.0.4645.1530
	     (same version as RunMemtest). Local builds without it get 0.0.0.1. -->
	<PropertyGroup>
		<ReleaseVersion Condition=" '$(ReleaseVersion)' == '' ">0.0.0.1</ReleaseVersion>
		<AssemblyVersion>$(ReleaseVersion)</AssemblyVersion>
		<FileVersion>$(ReleaseVersion)</FileVersion>
		<Version>$(ReleaseVersion)</Version>
	</PropertyGroup>

	<!-- Package/: RunMemtest build output, copied in by the release script (not in git).
	     Every file is embedded with its relative path kept, so the launcher can restore
	     the folder layout (e.g. runtimes\win\lib\net8.0\...). -->
	<ItemGroup>
		<None Remove="Package\**" />
		<Compile Remove="Package\**" />
		<Content Remove="Package\**" />
		<EmbeddedResource Include="Package\**\*" LogicalName="Package/%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
